{
  "_description": "Chinese Geographic Ontology for visual geolocation. 30 regions with field fingerprints, spatial constraints, and sensor profiles.",
  "_version": "1.0",
  "_field_hierarchy": {
    "level_0_sensor": ["elevation_m", "temperature_c", "humidity_pct"],
    "level_1_macro": ["climate_zone"],
    "level_2_regional": ["terrain_type", "vegetation_zone", "soil_color"],
    "level_3_sub_regional": ["landform_detail", "mountain_rock_type", "water_type"],
    "level_4_cultural": ["urbanization", "architecture_style", "language_script", "pavement_type"],
    "level_5_local": ["tree_species", "building_height", "sky_quality", "scene_type"]
  },
  "_anchor_fields": {
    "description": "Fields that, when predicted with high confidence, strongly constrain region. Ordered by geographic distinctiveness.",
    "fields": [
      "language_script", "architecture_style", "mountain_rock_type",
      "soil_color", "climate_zone", "tree_species",
      "landform_detail", "terrain_type"
    ]
  },
  "constraints": {
    "impossible_combinations": [
      {"fields": {"climate_zone": "alpine", "tree_species": "coconut_palm"}, "reason": "Coconut palms require tropical climate"},
      {"fields": {"climate_zone": "alpine", "vegetation_zone": "tropical_rainforest"}, "reason": "Tropical rainforest cannot exist in alpine climate"},
      {"fields": {"climate_zone": "tropical", "mountain_rock_type": "snow_peaks_glaciers"}, "reason": "Glaciers require cold climate"},
      {"fields": {"climate_zone": "arid", "vegetation_zone": "tropical_rainforest"}, "reason": "Rainforest requires high precipitation"},
      {"fields": {"climate_zone": "boreal", "tree_species": "coconut_palm"}, "reason": "Coconut palms cannot survive boreal winters"},
      {"fields": {"terrain_type": "desert_dunes", "water_type": "waterfall"}, "reason": "Waterfalls cannot exist in sand dunes"},
      {"fields": {"terrain_type": "desert_dunes", "vegetation_zone": "bamboo_forest"}, "reason": "Bamboo requires moisture"},
      {"fields": {"urbanization": "metropolis", "scene_type": "wilderness_forest"}, "reason": "Metropolis and wilderness are contradictory"},
      {"fields": {"architecture_style": "tibetan_stone", "language_script": "uyghur_arabic"}, "reason": "Tibetan architecture occurs in Tibetan language regions, not Uyghur"},
      {"fields": {"architecture_style": "tulou", "climate_zone": "arid"}, "reason": "Tulou are in humid subtropical Fujian"},
      {"fields": {"soil_color": "loess_yellow", "vegetation_zone": "tropical_rainforest"}, "reason": "Loess is arid/semi-arid, not rainforest"},
      {"fields": {"tree_species": "banyan", "climate_zone": "boreal"}, "reason": "Banyan trees require warm climate"},
      {"fields": {"tree_species": "chinese_red_pine", "climate_zone": "tropical"}, "reason": "Red pine is temperate/boreal species"}
    ],
    "sensor_constraints": {
      "elevation_to_climate": {
        ">4000m": ["alpine"],
        "2500-4000m": ["alpine", "boreal", "arid"],
        "1000-2500m": ["temperate", "arid", "subtropical", "boreal"],
        "200-1000m": ["temperate", "subtropical", "arid", "tropical"],
        "<200m": ["temperate", "subtropical", "tropical", "arid"]
      },
      "temperature_to_climate": {
        "<0°C": ["alpine", "boreal"],
        "0-10°C": ["boreal", "temperate", "alpine"],
        "10-20°C": ["temperate", "subtropical", "arid"],
        "20-30°C": ["subtropical", "tropical", "arid"],
        ">30°C": ["tropical", "arid"]
      }
    }
  },
